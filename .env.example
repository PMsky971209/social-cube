PORT=8787
SOCIAL_CUBE_DB=data/social-cube.sqlite
SOCIAL_CUBE_SEED=1

# auto | qwen | mock  （auto：有 key 用千问，否则 mock）
SOCIAL_CUBE_EXTRACTOR=auto

# 阿里云 DashScope API Key（通义千问）
# https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=

# 可选别名
# SOCIAL_CUBE_QWEN_API_KEY=

# 可选：模型与兼容模式 Base URL
# SOCIAL_CUBE_QWEN_MODEL=qwen-plus
# SOCIAL_CUBE_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
